
ifdef WITH_MUTATION_PP
    MPP_INC    = -I$(MPP_INCLUDE)
    EIGEN_INC  = -I$(EIGEN_INCLUDE)
    MPP_LINK   = -L$(MPP_LIB) -lmutation++ -Wl,-rpath,$(MPP_LIB)
