FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSchemes;
}

fluxScheme      AUSMPlusUp;

lowMachAusm     false;

ddtSchemes
{
    default         dualTime rPseudoDeltaT backward;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    div(tauMC)      Gauss linear;
    div(phi,Yi)     Gauss upwind;
    div(phi,epsVib) Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
    reconstruct(rho) wVanLeer;
    reconstruct(U)  wVanLeer;
    reconstruct(T)  wVanLeer;
}

snGradSchemes
{
    default         corrected;
}


