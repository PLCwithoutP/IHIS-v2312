FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      TVib_N2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $TValue;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $TValue;
    }
    outlet
    {
        type            zeroGradient;       // supersonic outflow
    }
    cone
    {
        type            neSmoluchowskiJumpTv;
        accommodationCoeff $alphaT;
        omega           $omegaVHS;
        Twall           uniform $TwallValue;
        value           uniform $TwallValue;
    }
    wedge1
    {
        type            wedge;
    }
    wedge2
    {
        type            wedge;
    }
}

// ************************************************************************* //
