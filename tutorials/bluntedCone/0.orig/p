FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pValue;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $pValue;
    }
    outlet
    {
        type            zeroGradient;       // supersonic outflow
    }
    cone
    {
        type            characteristicWallPressure;
        value           uniform $pValue;
    }
    wedge1
    {
        type            wedge;
    }
    wedge2
    {
        type            wedge;
    }
}

