FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pressureValue;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $pressureValue;
    }

    cone
    {
        type            zeroGradient;
    }

    wedge1
    {
        type            wedge;
    }

    wedge2
    {
        type            wedge;
    }

    outlet
    {
        type            zeroGradient;
    }
}


