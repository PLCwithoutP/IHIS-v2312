        beta            -1.0;
        Ta              59370.6;
        alphaPark       0.7;
        twoTemperature  true;
        KeqCoeffs       (1.335 -4.127 -0.616 0.093 -0.005);
        KeqTheta        59369.9;
        KeqTmin         2000.0;
