MAJ_VER := $(WM_PROJECT_VERSION:v%=%)
MAJ_VER := $(subst ., ,$(MAJ_VER))
MAJ_VER := $(word 1,$(MAJ_VER))

ifeq ($(shell expr $(MAJ_VER) \< 2312), 1)
    $(warning IHIS targets OpenFOAM-v2312 (ESI). Other versions are untested.)
endif

THERMO_INC  = -I$(LIB_SRC)/transportModels/compressible/lnInclude
THERMO_LIBS = -lfluidThermophysicalModels -lcompressibleTransportModels

FV_OPTIONS_LIB = -lfvOptions

DYN_MESH_INCLUDE = -I$(LIB_SRC)/dynamicFvMesh/lnInclude
DYN_MESH_LIB = -ldynamicFvMesh -ltopoChangerFvMesh